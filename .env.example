# Vercel 또는 로컬 서버의 전용 Postgres 연결 URI
BABYCARE_DATABASE_URL=
# 선택: 상대 경로는 프로젝트 루트 기준
# DATABASE_CA_FILE=./prod-ca-2021.crt
# Vercel에서는 위 경로 대신 CA 인증서의 PEM 내용을 환경변수로 설정
# DATABASE_CA_PEM=

# 개인비서 Supabase 프로젝트의 URL과 Publishable Key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 워커 API의 서버 전용 인증 토큰
BABYCARE_WORKER_TOKEN=

# Vercel 또는 로컬 서버 전용 Supabase Storage 키
BABYCARE_STORAGE_SECRET_KEY=

# iMac에서 사용할 Codex CLI 경로. 실행 파일 또는 Node.js 진입점 중 하나를 선택한다.
# CODEX_EXECUTABLE=
# CODEX_JS=
# CODEX_MODEL=
# CODEX_TIMEOUT_SECONDS=
